{
  "expo": {
    "name": "Super Tent House",
    "slug": "bolt-expo-nativewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c320debc-90d6-4584-ba56-7be23be05927"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "package": "com.ausalasaikrishna.boltexponativewind"
    }
  }
}
